# Copied to ~/buddy/config/buddy.env on the Pi by setup-pi.sh. Edit it there, not here.
BUDDY_MQTT_HOST=localhost
BUDDY_MQTT_PORT=1883
#BUDDY_MQTT_USER=
#BUDDY_MQTT_PASSWORD=

# ears (1.6 wake word, 1.7 speech-to-text). Defaults shown; uncomment to change.
#BUDDY_MODELS_DIR=/home/dev/buddy/models
#BUDDY_EARS_DEVICE=default           # ALSA device; "default" = PipeWire
#BUDDY_EARS_DEBUG=0                  # 1 = log every wake word score ≥ 0.1 (tuning only: noisy)
#BUDDY_WAKE_MODEL=hey_jarvis_v0.1.onnx
#BUDDY_WAKE_THRESHOLD=0.5            # higher = fewer false triggers, but needs clearer speech
#BUDDY_WAKE_PATIENCE=2               # consecutive 80 ms chunks above threshold
#BUDDY_VAD_THRESHOLD=0.5
#BUDDY_VAD_SILENCE_MS=700            # pause that ends a command (shorter = faster, but cuts slow talkers)
#BUDDY_VAD_START_TIMEOUT_MS=4000     # give up if nothing is said after the wake word
#BUDDY_VAD_MAX_MS=10000
#BUDDY_STT_MODEL=ggml-base.en.bin
#BUDDY_STT_LANGUAGE=en               # en | de | auto (needs a multilingual model, e.g. ggml-base.bin)
#BUDDY_STT_THREADS=4
#BUDDY_STT_PROMPT=Spotify, Buddy     # vocabulary hint for whisper
