# Spotify Connect device "Buddy": librespot from the raspotify package, run as a *user* unit so it plays
# through the user's PipeWire session (via pipewire-pulse). raspotify's own system service is disabled
# by setup-pi.sh: a system service can't reach a user's PipeWire.
#
# Login (once): open Spotify on a phone/PC in the same Wi-Fi, pick the device "Buddy". librespot caches
# the credentials in ~/.cache/librespot and logs in by itself from then on.
#
# --name must match BUDDY_SPOTIFY_DEVICE (default "Buddy").
[Unit]
Description=Buddy: Spotify Connect (librespot)
After=pipewire-pulse.service
Wants=pipewire-pulse.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# --disable-audio-cache: no song files on the microSD (wear). --quiet: warnings and errors only.
ExecStart=/usr/bin/librespot \
    --name Buddy \
    --device-type speaker \
    --backend pulseaudio \
    --bitrate 160 \
    --initial-volume 50 \
    --enable-volume-normalisation \
    --autoplay on \
    --cache %h/.cache/librespot \
    --disable-audio-cache \
    --quiet
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
