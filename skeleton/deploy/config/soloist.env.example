# Copied to ~/buddy/config/soloist.env (mode 600) by setup.sh soloist. Only buddy-soloist.service reads it:
# kept apart from buddy.env so the sandboxed, closed-source Soloist sees nothing but its own settings.
# Comments only on their own lines (systemd EnvironmentFile).

# Developer dashboard → Spotify Soloist API Key (needs Premium). Required.
SOLOIST_API_KEY=

# Name in the Spotify app. Must equal BUDDY_SPOTIFY_LOCAL_DEVICE in buddy.env (default Buddy); the panel hides it
# and shows the Nests instead (D20).
SOLOIST_DEVICE_NAME=Buddy
