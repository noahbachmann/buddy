# Copied to ~/buddy/config/buddy.env on the Pi by deploy/pi/setup.sh. Edit it there, not here: keep only the
# lines you change. `setup.sh check` warns about keys that no service reads.
# Comments only on their own lines: systemd keeps a trailing "# …" as part of the value.
BUDDY_MQTT_HOST=localhost
BUDDY_MQTT_PORT=1883
#BUDDY_MQTT_USER=
#BUDDY_MQTT_PASSWORD=

# ears (1.6 wake word, 1.7 speech-to-text). Defaults shown; uncomment to change.
#BUDDY_MODELS_DIR=/home/dev/buddy/models

# ALSA device: the echo-cancelled mic (deploy/config/pipewire). "default" = the raw Jabra mic
#BUDDY_EARS_DEVICE=pipewire:NODE=buddy_aec_source

# 1 = ignore wake words while Buddy speaks (buddy/voice/state), so it can't wake itself
#BUDDY_EARS_IGNORE_WHILE_SPEAKING=1

# 1 = log every wake word score ≥ 0.1 (tuning only: noisy)
#BUDDY_EARS_DEBUG=0

#BUDDY_WAKE_MODEL=hey_jarvis_v0.1.onnx
# Higher = fewer false triggers, but needs clearer speech
#BUDDY_WAKE_THRESHOLD=0.5
# Consecutive 80 ms chunks above threshold
#BUDDY_WAKE_PATIENCE=2

#BUDDY_VAD_THRESHOLD=0.5
# Pause that ends a command (shorter = faster, but cuts slow talkers)
#BUDDY_VAD_SILENCE_MS=700
# Give up if nothing is said after the wake word
#BUDDY_VAD_START_TIMEOUT_MS=4000
# Hard cap on command length
#BUDDY_VAD_MAX_MS=5000
# Ignore background speech (TV): only speech louder than this point between the background (0) and your
# wake word (1) counts. Higher = ignores louder TV, but may cut quiet words. 0 = off
#BUDDY_VAD_LEVEL_GATE=0.4

#BUDDY_STT_MODEL=ggml-base.en.bin
# en | de | auto (auto/de need a multilingual model, e.g. ggml-base.bin)
#BUDDY_STT_LANGUAGE=en
#BUDDY_STT_THREADS=4
# Vocabulary hint for whisper, e.g. "Spotify, Hans Zimmer, Daughter". Empty = none. Check with deploy/train.sh --eval
#BUDDY_STT_PROMPT=

# spotify (1.9). Client ID from https://developer.spotify.com/dashboard (your app → Settings). Required.
#BUDDY_SPOTIFY_CLIENT_ID=
# Must be listed exactly like this under "Redirect URIs" in the app settings
#BUDDY_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
#BUDDY_SPOTIFY_TOKEN_FILE=/home/dev/buddy/config/spotify-token.json
# The music box: its name in the Spotify app (devices list). Required
#BUDDY_SPOTIFY_DEVICE=
# Box volume while Buddy listens or speaks, in % of its volume (ducking). 100 = no ducking
#BUDDY_SPOTIFY_DUCK_PERCENT=30
# Quiet time before the volume comes back (covers the gap between your command and Buddy's reply)
#BUDDY_SPOTIFY_DUCK_HOLD_MS=1500
# Percent per "louder" / "quieter"
#BUDDY_SPOTIFY_VOLUME_STEP=10
# Played by "play" when there is nothing to resume, e.g. spotify:playlist:37i9dQZF1DXcBWIGoYBM5M
#BUDDY_SPOTIFY_DEFAULT_URI=

# voice (1.10). Voice file in BUDDY_MODELS_DIR; more: deploy/pi/fetch-models.sh <voice>
#BUDDY_VOICE_MODEL=en_GB-alan-medium.onnx
#BUDDY_VOICE_DEVICE=default
# > 1 speaks slower, < 1 faster
#BUDDY_VOICE_LENGTH_SCALE=1.0
# Loudness; > 1 can clip
#BUDDY_VOICE_GAIN=1.0
#BUDDY_VOICE_ESPEAK_DATA=/opt/libpiper/share/espeak-ng-data
# CPU cores for speech synthesis (more = reply starts sooner; 3 leaves one for ears). Needs libpiper from setup.sh
#BUDDY_VOICE_THREADS=3

