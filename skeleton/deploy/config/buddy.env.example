# Copied to ~/buddy/config/buddy.env on the Pi by deploy/pi/setup.sh. Edit it there, not here: keep only the
# lines you change. `setup.sh check` warns about keys that no service reads.
# Comments only on their own lines: systemd keeps a trailing "# …" as part of the value.
BUDDY_MQTT_HOST=localhost
BUDDY_MQTT_PORT=1883
#BUDDY_MQTT_USER=
#BUDDY_MQTT_PASSWORD=

# ears (1.6 wake word, 1.7 speech-to-text). Defaults shown; uncomment to change.
#BUDDY_MODELS_DIR=/home/dev/buddy/models

# ALSA device. "default" = PipeWire's default source, the Jabra mic (raw: no echo cancellation, D13)
#BUDDY_EARS_DEVICE=default

# 1 = ignore wake words while Buddy speaks (buddy/voice/state), so it can't wake itself
#BUDDY_EARS_IGNORE_WHILE_SPEAKING=1

# 1 = log every wake word score ≥ 0.1 (tuning only: noisy)
#BUDDY_EARS_DEBUG=0

#BUDDY_WAKE_MODEL=hey_jarvis_v0.1.onnx
# Higher = fewer false triggers, but needs clearer speech
#BUDDY_WAKE_THRESHOLD=0.5
# Consecutive 80 ms chunks above threshold
#BUDDY_WAKE_PATIENCE=2

#BUDDY_VAD_THRESHOLD=0.5
# Pause that ends a command (shorter = faster, but cuts slow talkers)
#BUDDY_VAD_SILENCE_MS=700
# Give up if nothing is said after the wake word
#BUDDY_VAD_START_TIMEOUT_MS=4000
# Hard cap on command length
#BUDDY_VAD_MAX_MS=5000
# Ignore background speech (TV): only speech louder than this point between the background (0) and your
# wake word (1) counts. Higher = ignores louder TV, but may cut quiet words. 0 = off
#BUDDY_VAD_LEVEL_GATE=0.4

#BUDDY_STT_MODEL=ggml-base.en.bin
# en | de | auto (auto/de need a multilingual model, e.g. ggml-base.bin)
#BUDDY_STT_LANGUAGE=en
#BUDDY_STT_THREADS=4
# Vocabulary hint for whisper, e.g. "Spotify, Hans Zimmer, Daughter". Empty = none. Compare with deploy/train.sh eval
#BUDDY_STT_PROMPT=
# Encoder window: 0 = whisper's full 30 s, auto = sized to the command (much faster; for models trained with it by
# deploy/train.sh, stock models lose accuracy), N = fixed. deploy/train.sh install sets it with the model
#BUDDY_STT_AUDIO_CTX=0
# 1 = re-decode at higher temperature when whisper is unsure (whisper's default). Off: same accuracy on commands,
# no multi-second worst cases
#BUDDY_STT_FALLBACK=0
# Save every command's audio + transcript here for training on real use (deploy/train.sh pull, then label).
# Empty = off. Keeps the newest BUDDY_EARS_SAVE_MAX commands (~100 KB each)
#BUDDY_EARS_SAVE_DIR=
#BUDDY_EARS_SAVE_MAX=500

# spotify (1.9). Client ID from https://developer.spotify.com/dashboard (your app → Settings). Required.
#BUDDY_SPOTIFY_CLIENT_ID=
# Must be listed exactly like this under "Redirect URIs" in the app settings
#BUDDY_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
#BUDDY_SPOTIFY_TOKEN_FILE=/home/dev/buddy/config/spotify-token.json
# The default speaker: a Nest's name (buddy-speakers --cmd list) or a name in the Spotify app. Required.
# Other speakers need no config: "play … on the bathroom speaker" finds them by name (buddy-spotify --cmd devices)
#BUDDY_SPOTIFY_DEVICE=
# Soloist's Connect name (soloist.env SOLOIST_DEVICE_NAME): hidden, the Nests are listed in its place (D20)
#BUDDY_SPOTIFY_LOCAL_DEVICE=Buddy
# Other speakers in Buddy's room, ducked like the box while he listens or speaks (comma-separated names)
#BUDDY_SPOTIFY_DUCK_DEVICES=desktop-1
# Box volume while Buddy listens or speaks, in % of its volume (ducking). 100 = no ducking
#BUDDY_SPOTIFY_DUCK_PERCENT=30
# Quiet time before the volume comes back (covers the gap between your command and Buddy's reply)
#BUDDY_SPOTIFY_DUCK_HOLD_MS=1500
# Percent per "louder" / "quieter"
#BUDDY_SPOTIFY_VOLUME_STEP=10
# Played by "play" when there is nothing to resume, e.g. spotify:playlist:37i9dQZF1DXcBWIGoYBM5M
#BUDDY_SPOTIFY_DEFAULT_URI=
# Seconds between polls of what Spotify plays, only while a web panel is open (2 requests each)
#BUDDY_SPOTIFY_POLL_S=3

# speakers (1.15): the Nests over Bluetooth (D20). Pair one: buddy-speakers --pair "<alias>"
# The Nest music goes to until another is chosen (name as in buddy-speakers --cmd list). Empty =
# BUDDY_SPOTIFY_DEVICE, else the first
#BUDDY_SPEAKERS_DEFAULT=
# Disconnect Bluetooth after this many seconds without music
#BUDDY_SPEAKERS_IDLE_S=600
# The Nest's own volume, set when it connects; the Spotify slider changes the music within it
#BUDDY_SPEAKERS_VOLUME=80
# Buddy's voice on a Nest, in % (on the Jabra always 100)
#BUDDY_SPEAKERS_VOICE_PERCENT=60
# Music volume on the Nest while Buddy listens or speaks, in %. 100 = no ducking
#BUDDY_SPEAKERS_DUCK_PERCENT=30
# Quiet time before the music comes back
#BUDDY_SPEAKERS_DUCK_HOLD_MS=1500

# hue (1.13). Pair once: press the bridge's link button, then ~/buddy/bin/buddy-hue --pair (writes the key file)
#BUDDY_HUE_KEY_FILE=/home/dev/buddy/config/hue.json
# Bridge IP: only if discovery fails at --pair, or the bridge's IP changed (better: fixed IP in the router)
#BUDDY_HUE_BRIDGE=
# The room Buddy stands in, as named in the Hue app: "lights off" without a room means this one. Empty = every light
#BUDDY_HUE_DEFAULT_ROOM=
# Percent per "brighter" / "darker"
#BUDDY_HUE_STEP=20

# messenger (1.16): Buddy's notices and questions in Dev's Telegram chat (D22). Pair once: create a bot with
# @BotFather, then ~/buddy/bin/buddy-messenger --pair (writes the key file: bot token + Dev's chat, never in Git)
#BUDDY_MESSENGER_KEY_FILE=/home/dev/buddy/config/messenger.json
# Open questions, kept across restarts
#BUDDY_MESSENGER_DATA_DIR=/home/dev/buddy/data/messenger
# How long a question waits for Dev unless the asker says otherwise (ttl_s). 0 = forever
#BUDDY_MESSENGER_TTL_S=86400
# A watched service offline this long → alert in the chat. 0 = no alerts
#BUDDY_MESSENGER_OFFLINE_S=300
# The services watched (space or comma separated): the units that should always run
#BUDDY_MESSENGER_WATCH=ears brain spotify hue web voice motion speakers table system

# web (1.14): the panel at http://buddy.local:8080 (phone, PC). No login: anyone on the LAN can use it (D19)
#BUDDY_WEB_PORT=8080
# 127.0.0.1 = only from the Pi itself (e.g. behind your own reverse proxy)
#BUDDY_WEB_BIND=0.0.0.0
#BUDDY_WEB_ROOT=/home/dev/buddy/share/web
# Host names besides IPs, localhost and *.local that may open the panel (comma-separated), e.g. a router DNS name
#BUDDY_WEB_HOSTS=

# system (1.17): host metrics on the panel (CPU, RAM, disk, temperature, fan, network, throttle flags)
# Card name, default = the hostname. Set it on every extra host ("Pi 2"): the service then runs as system-pi-2
# with topics buddy/system-pi-2/{state,status}, so hosts don't kick each other off the broker
#BUDDY_SYSTEM_NAME=
# Seconds between samples, 1-15 (the systemd watchdog needs a ping at least every 15 s)
#BUDDY_SYSTEM_INTERVAL_S=5

# voice (1.10). Voice file in BUDDY_MODELS_DIR; more: deploy/pi/fetch-models.sh <voice>
#BUDDY_VOICE_MODEL=en_GB-alan-medium.onnx
# buddy_voice: speakers sends it to the Nest that plays music, else the Jabra (D20). Missing → ALSA default
#BUDDY_VOICE_DEVICE=pipewire:NODE=buddy_voice
# > 1 speaks slower, < 1 faster
#BUDDY_VOICE_LENGTH_SCALE=1.0
# Loudness; > 1 can clip
#BUDDY_VOICE_GAIN=1.0
#BUDDY_VOICE_ESPEAK_DATA=/opt/libpiper/share/espeak-ng-data
# CPU cores for speech synthesis (more = reply starts sooner; 3 leaves one for ears). Needs libpiper from setup.sh
#BUDDY_VOICE_THREADS=3


# motion (2.3): the Pico (udev symlink from setup.sh pico)
#BUDDY_MOTION_DEVICE=/dev/buddy-pico
# 1 = log every serial line in both directions (debugging only: noisy)
#BUDDY_MOTION_DEBUG=0

# game (Phase 5): Riftbound card data from deploy/pi/fetch-cards.sh, decklists installed by deploy.sh game
#BUDDY_GAME_CARDS=/home/dev/buddy/data/riftbound/cards.json
#BUDDY_GAME_DECKS=/home/dev/buddy/share/game/decks
# the service (5.6, #52): Buddy's AI per decision (ISMCTS, #38: 2 s on 3 threads; the 4th core stays for ears)
#BUDDY_GAME_BUDGET_MS=2000
#BUDDY_GAME_THREADS=3
# a table command without an answer this long pauses the game (a late answer goes on; resume resends it)
#BUDDY_GAME_TABLE_TIMEOUT_S=30
# journal + replay per game; a restart resumes the newest unfinished one
#BUDDY_GAME_GAMES=/home/dev/buddy/data/riftbound/games

# table (5.5): Buddy's physical cards. Only the sim backend exists until 5.7.
#BUDDY_TABLE_BACKEND=sim
# sim faults: "none", "stress" (the 5.5 soak rates) or misread=0.02,unreadable=0.05,double_feed=…,missed_feed=…,
# double_take=…,double_deal=…,disturbed=… (sim.hpp)
#BUDDY_TABLE_SIM_FAULTS=none
# 0 = a new seed per start
#BUDDY_TABLE_SIM_SEED=0
# reads of one code that make it the card's (soak #43: 3 leaves nothing unrecovered under stress, 2 does)
#BUDDY_TABLE_CONFIRM_READS=3
# scan the spot after placing a card: catches double deals and takes (off: ~21k unrecovered in the soak)
#BUDDY_TABLE_POST_CHECK=1

# screener (#66): screens chats in a social app on a dedicated Android phone (adb on the Pi's USB).
# The app's Android package: required, set it only in buddy.env on the host (the repo never names the app).
#BUDDY_SCREENER_APP=
# adb serial when more than one device is attached; empty = the only one
#BUDDY_SCREENER_SERIAL=
# keyboard switched to on pause (Dev types by hand); empty = the first enabled one that isn't the screener's
#BUDDY_SCREENER_STOCK_IME=
# phone check interval of the service (adb state, app in front)
#BUDDY_SCREENER_CHECK_S=30
# preferences, templates, contact files, stop file, forbidden fixture words / state and logs
#BUDDY_SCREENER_CONFIG=/home/dev/buddy/config/screener
#BUDDY_SCREENER_DATA=/home/dev/buddy/data/screener
# decisions (Agent SDK on Dev's plan; token from `claude setup-token` in <config>/claude-token, no API key)
#BUDDY_SCREENER_MODEL=claude-sonnet-5-5
#BUDDY_SCREENER_EFFORT=medium
#BUDDY_SCREENER_DECIDE_TIMEOUT_S=180
# cap on the SDK's API-equivalent $ per 24 h (the plan isn't billed per call: this only bounds runaway use)
#BUDDY_SCREENER_DAILY_USD=5
# like budget (#80): the app's free likes per batch (counted from the action log, stops before the paywall); 1 =
# they come back 24 h after a used-up batch's last like (Dev's guess: set once a `likes_back` action confirmed it)
#BUDDY_SCREENER_DAILY_LIKES=8
#BUDDY_SCREENER_LIKES_24H=0
# long side of a photo crop sent to Claude (px): photos are most of a profile's tokens, ~440 each at 512
#BUDDY_SCREENER_PHOTO_PX=512
# 1 = a text-only call looks for stated dealbreakers first; one → skip without sending photos
#BUDDY_SCREENER_TEXT_FIRST=1
# 1 = a photos-only call checks the physical preference before the full decision; yes → skip (#83). Its model
# (empty = BUDDY_SCREENER_MODEL) and its crops' long side (≥ 960 = the photo as shown, not downscaled)
#BUDDY_SCREENER_PHOTO_CHECK=1
#BUDDY_SCREENER_PHOTO_MODEL=
#BUDDY_SCREENER_PHOTO_CHECK_PX=1024
# model of the like comment's check (copy/translation of an example, invented facts about Dev, #84); empty = the
# decide model
#BUDDY_SCREENER_CHECK_MODEL=
# chat flow (#77): her answered turns before a match can be verified; our generated messages per chat (cap →
# handover); days open without a decision (→ handover); one nudge after N days without a reply (0 = off); closed
# silently N days after the nudge; unmatch N hours after closing
#BUDDY_SCREENER_CHAT_MIN_EXCHANGES=3
#BUDDY_SCREENER_CHAT_MAX_BOT=12
#BUDDY_SCREENER_CHAT_MAX_DAYS=7
#BUDDY_SCREENER_CHAT_NUDGE_DAYS=2
#BUDDY_SCREENER_CHAT_CLOSE_DAYS=3
#BUDDY_SCREENER_CHAT_UNMATCH_H=24
# --sim: the model that plays the simulated matches, and what the sim may spend per 24 h (API-equivalent $;
# its own cap: sim calls don't count against BUDDY_SCREENER_DAILY_USD)
#BUDDY_SCREENER_SIM_MODEL=claude-haiku-5-5
#BUDDY_SCREENER_SIM_USD=3
